diff --git a/.github/workflows/windows-exe.yml b/.github/workflows/windows-exe.yml
new file mode 100644
index 0000000..60e2d20
--- /dev/null
+++ b/.github/workflows/windows-exe.yml
@@ -0,0 +1,38 @@
+name: Windows exe
+
+# Builds bitchord.exe on a Windows runner and attaches it to the run as a download.
+# Run it by hand: Actions > "Windows exe" > Run workflow. The build takes a while
+# (release profile uses fat LTO); the file appears under "Artifacts" on the run page.
+on:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v5
+
+      - uses: dtolnay/rust-toolchain@stable
+
+      - uses: Swatinem/rust-cache@v2
+
+      - name: Build
+        run: cargo build --release --locked
+
+      # webview2-com-sys extracts WebView2Loader.dll into the build's OUT_DIR, not next to
+      # the exe. It goes beside it here, so the sign-in windows find it.
+      - name: Stage files
+        shell: pwsh
+        run: |
+          New-Item -ItemType Directory -Force out | Out-Null
+          Copy-Item target\release\bitchord.exe out\
+          $dll = Get-ChildItem -Path "target\release\build\*\out\x64\WebView2Loader.dll" -ErrorAction SilentlyContinue | Select-Object -First 1
+          if (-not $dll) { $dll = Get-ChildItem -Path "$HOME\.cargo\registry\src\*\webview2-com-sys-*\x64\WebView2Loader.dll" -ErrorAction SilentlyContinue | Select-Object -First 1 }
+          if ($dll) { Copy-Item $dll.FullName out\ } else { Write-Warning "WebView2Loader.dll not found; sign-in windows may not open" }
+          Get-ChildItem out
+
+      - uses: actions/upload-artifact@v5
+        with:
+          name: bitchord-windows-x64
+          path: out
+          if-no-files-found: error
